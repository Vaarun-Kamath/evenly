# Copy to `.env` for local development. Every variable is validated at startup
# (apps/server/src/env.ts); the server exits with a clear message if one is invalid.

# Postgres connection. Use the project's own database and role (PLATFORM.md section 4).
DATABASE_URL=postgres://lib001:lib001@localhost:5432/lib001

# Public address of the app, including any sub-path (e.g. https://example.com/evenly).
# The base path is derived from this URL's path.
PUBLIC_URL=http://localhost:3000

# Optional. Only to double-check the path of PUBLIC_URL: if set, it must match.
# BASE_PATH=

PORT=3000
LOG_LEVEL=info

# false | true | <number of proxy hops> | comma-separated IPs/CIDRs. Set a hop count when
# running behind a reverse proxy. See docs/adr/0002-base-path-cookies-origin.md.
TRUST_PROXY=false

# Extra allowed Origin values, comma-separated. Optional.
# TRUSTED_ORIGINS=

# Signs session cookies: at least 32 random characters (`openssl rand -base64 32`).
# Optional: when unset, the server generates a secret on first start and keeps it in its database.
# Setting it is recommended for anything public; changing it signs everyone out.
# SESSION_SECRET=

# true | false | invite-only. Who may create an account. Existing users can always sign in.
ALLOW_SIGNUPS=true

# Optional direct (non-pooled) connection used for migrations, e.g. when PgBouncer is in front.
# MIGRATION_DATABASE_URL=

# Used only by the integration tests: a login that can create databases, on the `postgres` database.
# TEST_DATABASE_URL=postgres://lib001:lib001@localhost:5432/postgres

# Optional: enables email features such as password reset by email. SMTP_FROM is then required.
# SMTP_URL=smtp://user:pass@host:587
# SMTP_FROM=evenly@example.com

# Used by docker-compose.yml for the bundled Postgres.
# POSTGRES_PASSWORD=lib001
