{
  "name": "@evenly/server",
  "version": "0.0.0",
  "private": true,
  "description": "Evenly API server. In production it also serves the built web app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@evenly/contracts": "workspace:*",
    "@evenly/core": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/static": "^10.1.6",
    "@fastify/type-provider-zod": "^1.0.0",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
